{
  "name": "envdiff",
  "version": "0.1.0",
  "description": "Deep-compare two environments or branches of a web app: crawl both, click every actionable element, and report visual and functional regressions.",
  "type": "module",
  "bin": {
    "envdiff": "bin/envdiff.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "action.yml"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js test/branches.test.js",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc -p jsconfig.json",
    "fixture": "node test/fixtures/site/server.js",
    "demo": "node test/demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suchith-arella/envdiff.git"
  },
  "homepage": "https://github.com/suchith-arella/envdiff#readme",
  "bugs": {
    "url": "https://github.com/suchith-arella/envdiff/issues"
  },
  "keywords": [
    "qa",
    "visual-regression",
    "e2e",
    "playwright",
    "environment-comparison",
    "github-action"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@axe-core/playwright": "^4.13.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
